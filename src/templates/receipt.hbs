<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Receipt - {{receiptNumber}}</title>
    <link
      href='https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600&family=Noto+Sans:wght@400;500;600;700&display=swap'
      rel='stylesheet'
    />
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      :root {
        /* Core Learning Centre brand palette, pulled from the logo */
        --navy: #16305A;
        --navy-deep: #0E2142;
        --teal: #16A6B6;
        --teal-dark: #0E8493;
        --orange: #F5A623;
        --orange-dark: #E8890B;
        --sky: #7FCBE8;
        --ink: #1E293B;
        --muted: #64748B;
        --line: #E2E8F0;
        --bg: #EEF3F7;
      }

      body {
        font-family: 'Inter', 'Noto Sans', sans-serif;
        background-color: var(--bg);
        padding: 40px;
        color: var(--ink);
      }

      .receipt-container {
        max-width: 800px;
        margin: 0 auto;
        background: #ffffff;
        border-radius: 18px;
        box-shadow: 0 20px 45px -15px rgba(14, 33, 66, 0.25);
        overflow: hidden;
        position: relative;
      }

      /* ---------- Header ---------- */
      .receipt-header {
        position: relative;
        background: linear-gradient(135deg, var(--navy-deep) 0%, var(--navy) 55%, var(--teal-dark) 100%);
        color: #ffffff;
        padding: 36px 40px 28px;
        display: flex;
        align-items: center;
        gap: 18px;
      }

      .brand-mark {
        width: 52px;
        height: 52px;
        border-radius: 12px;
        flex-shrink: 0;
        display: flex;
        align-items: flex-end;
        overflow: hidden;
        box-shadow: 0 6px 16px rgba(0,0,0,0.25);
      }

      .brand-mark img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        background: #05121f;
      }

      /* fallback mark used automatically if{{logoUrl}}is not provided */
         .brand-mark.fallback {
           display: flex;
         }
         .brand-mark.fallback span {
           flex: 1;
           height: 100%;
           display: flex;
           align-items: flex-end;
           justify-content: center;
           font-family: 'JetBrains Mono', monospace;
           font-weight: 700;
           font-size: 9px;
           color: #ffffff;
           padding-bottom: 4px;
         }
         .brand-mark.fallback span:first-child { background: var(--teal); }
         .brand-mark.fallback span:last-child { background: var(--orange); }

         .brand-copy h1 {
           font-size: 22px;
           font-weight: 800;
           letter-spacing: -0.01em;
           line-height: 1.15;
         }

         .brand-copy p {
           font-size: 13px;
           color: rgba(255,255,255,0.72);
           margin-top: 3px;
         }

         .receipt-tag {
           margin-left: auto;
           text-align: right;
           flex-shrink: 0;
         }

         .receipt-tag .label {
           font-family: 'JetBrains Mono', monospace;
           font-size: 10px;
           text-transform: uppercase;
           letter-spacing: 0.12em;
           color: rgba(255,255,255,0.6);
         }

         .receipt-tag .value {
           font-size: 16px;
           font-weight: 700;
           margin-top: 4px;
         }

         /* brand strip, echoes the two-tone banner in the logo */
         .brand-strip {
           display: flex;
           height: 6px;
         }
         .brand-strip span { flex: 1; }
         .brand-strip span:first-child { background: var(--teal); }
         .brand-strip span:last-child { background: linear-gradient(90deg, var(--orange) 0%, var(--orange-dark) 100%); }

         /* ---------- Body ---------- */
         .receipt-body {
           padding: 36px 40px 8px;
         }

         .receipt-meta {
           display: grid;
           grid-template-columns: repeat(4, 1fr);
           gap: 20px;
           margin-bottom: 28px;
           padding-bottom: 24px;
           border-bottom: 2px dashed var(--line);
         }

         .receipt-meta-section h3 {
           font-family: 'JetBrains Mono', monospace;
           font-size: 10px;
           text-transform: uppercase;
           letter-spacing: 0.1em;
           color: var(--muted);
           margin-bottom: 7px;
           font-weight: 600;
         }

         .receipt-meta-section p {
           font-size: 14px;
           color: var(--ink);
           line-height: 1.5;
           font-weight: 500;
         }

         .receipt-meta-section .highlight {
           font-weight: 700;
           color: var(--teal-dark);
         }

         .status-pill {
           display: inline-block;
           font-size: 12px;
           font-weight: 700;
           padding: 3px 10px;
           border-radius: 999px;
           background: rgba(22, 166, 182, 0.12);
           color: var(--teal-dark);
         }

         /* ---------- Items table ---------- */
         .items-table {
           width: 100%;
           border-collapse: collapse;
           margin-bottom: 22px;
         }

         .items-table thead th {
           padding: 10px 14px;
           text-align: left;
           font-family: 'JetBrains Mono', monospace;
           font-size: 10px;
           text-transform: uppercase;
           letter-spacing: 0.1em;
           color: #ffffff;
           font-weight: 600;
           background: var(--navy);
         }

         .items-table thead th:first-child { border-radius: 8px 0 0 8px; }
         .items-table thead th:last-child { border-radius: 0 8px 8px 0; text-align: right; }

         .items-table td {
           padding: 15px 14px;
           border-bottom: 1px solid var(--line);
           font-size: 14px;
           font-family: 'Inter', 'Noto Sans', sans-serif;
         }

         .items-table td:last-child { text-align: right; }
         .items-table tbody tr:last-child td { border-bottom: none; }
         .items-table tbody tr:hover td { background: #FAFCFD; }

         .items-table .item-name {
           font-weight: 600;
           color: var(--ink);
         }

         .items-table .item-variant {
           font-size: 12px;
           color: var(--muted);
           margin-top: 2px;
         }

         /* ---------- Totals ---------- */
         .totals-section {
           display: flex;
           justify-content: flex-end;
           margin-bottom: 8px;
         }

         .totals-table {
           width: 300px;
           border-collapse: collapse;
         }

         .totals-table td {
           padding: 7px 0;
           font-size: 14px;
           color: var(--muted);
           font-family: 'Inter', 'Noto Sans', sans-serif;
         }

         .totals-table td:last-child {
           text-align: right;
           font-weight: 600;
           color: var(--ink);
         }

         .totals-table .discount-row td:last-child {
           color: var(--orange-dark);
         }

         .totals-table .grand-total-row td {
           padding-top: 14px;
           border-top: 2px solid var(--navy);
         }

         .totals-table .grand-total-row td:first-child {
           font-size: 15px;
           font-weight: 700;
           color: var(--ink);
         }

         .totals-table .grand-total-row td:last-child {
           font-size: 22px;
           font-weight: 800;
           color: var(--teal-dark);
         }

         /* ---------- Footer ---------- */
         .receipt-footer {
           background: linear-gradient(180deg, #F7FAFC 0%, #EEF3F7 100%);
           padding: 30px 40px 32px;
           text-align: center;
           border-top: 1px solid var(--line);
         }

         .qr-code {
           display: inline-block;
           margin-bottom: 18px;
           padding: 12px;
           background: white;
           border-radius: 10px;
           box-shadow: 0 4px 12px rgba(14, 33, 66, 0.1);
           border: 1px solid var(--line);
         }

         .qr-code img {
           width: 110px;
           height: 110px;
           display: block;
         }

         .receipt-footer .thank-you {
           font-size: 16px;
           font-weight: 700;
           color: var(--ink);
           margin-bottom: 6px;
         }

         .receipt-footer .thank-you span {
           color: var(--teal-dark);
         }

         .receipt-footer p.meta-line {
           font-size: 12px;
           color: var(--muted);
           line-height: 1.7;
         }

         .footer-brand-strip {
           display: flex;
           justify-content: center;
           gap: 6px;
           margin-top: 18px;
         }

         .footer-brand-strip span {
           width: 22px;
           height: 4px;
           border-radius: 2px;
           background: var(--line);
         }
         .footer-brand-strip span.on:nth-child(1) { background: var(--teal); }
         .footer-brand-strip span.on:nth-child(2) { background: var(--navy); }
         .footer-brand-strip span.on:nth-child(3) { background: var(--orange); }

         .watermark {
           position: fixed;
           top: 50%;
           left: 50%;
           transform: translate(-50%, -50%) rotate(-30deg);
           font-size: 130px;
           font-weight: 800;
           color: rgba(22, 48, 90, 0.035);
           pointer-events: none;
           z-index: 0;
           white-space: nowrap;
           letter-spacing: 0.05em;
         }

         @media print {
           body { padding: 0; background: white; }
           .receipt-container { box-shadow: none; border-radius: 0; }
           .watermark { display: none; }
           .items-table tbody tr:hover td { background: transparent; }
         }

         @media (max-width: 600px) {
           body { padding: 16px; }
           .receipt-header { flex-wrap: wrap; padding: 28px 24px 22px; }
           .receipt-tag { margin-left: 0; text-align: left; width: 100%; }
           .receipt-body { padding: 28px 24px 8px; }
           .receipt-meta { grid-template-columns: repeat(2, 1fr); }
           .receipt-footer { padding: 26px 24px 28px; }
         }
    </style>
  </head>
  <body>
    <div class='watermark'>{{#if
        paymentStatus
      }}{{paymentStatus}}{{else}}PAID{{/if}}</div>

    <div class='receipt-container'>
      <div class='receipt-header'>
        {{#if logoUrl}}
          <div class='brand-mark'>
            <img src='{{logoUrl}}' alt='Core Learning Centre' />
          </div>
        {{else}}
          <div class='brand-mark fallback'>
            <span>CORE</span><span>CLC</span>
          </div>
        {{/if}}

        <div class='brand-copy'>
          <h1>Core Learning Centre</h1>
          <p>Bookstore &amp; Learning Resources</p>
        </div>

        <div class='receipt-tag'>
          <div class='label'>Receipt</div>
          <div class='value'>#{{receiptNumber}}</div>
        </div>
      </div>
      <div class='brand-strip'><span></span><span></span></div>

      <div class='receipt-body'>
        <div class='receipt-meta'>
          <div class='receipt-meta-section'>
            <h3>Receipt Number</h3>
            <p class='highlight'>{{receiptNumber}}</p>
          </div>
          <div class='receipt-meta-section'>
            <h3>Date</h3>
            <p>{{date}}</p>
          </div>
          <div class='receipt-meta-section'>
            <h3>Payment Method</h3>
            <p>{{paymentMethod}}</p>
          </div>
          <div class='receipt-meta-section'>
            <h3>Status</h3>
            <p><span class='status-pill'>{{paymentStatus}}</span></p>
          </div>
        </div>

        <table class='items-table'>
          <thead>
            <tr>
              <th style='width: 40%;'>Item</th>
              <th style='width: 15%;'>Qty</th>
              <th style='width: 20%;'>Price</th>
              <th style='width: 25%;'>Subtotal</th>
            </tr>
          </thead>
          <tbody>
            {{#each items}}
              <tr>
                <td>
                  <div class='item-name'>{{bookTitle}}</div>
                  {{#if paperName}}
                    <div class='item-variant'>{{paperName}}</div>
                  {{/if}}
                </td>
                <td>{{quantity}}</td>
                <td>৳{{unitPrice}}</td>
                <td>৳{{subtotal}}</td>
              </tr>
            {{/each}}
          </tbody>
        </table>

        <div class='totals-section'>
          <table class='totals-table'>
            <tr>
              <td>Subtotal</td>
              <td>৳{{subtotal}}</td>
            </tr>
            {{#if discount}}
              <tr class='discount-row'>
                <td>Discount</td>
                <td>-৳{{discount}}</td>
              </tr>
            {{/if}}
            <tr>
              <td>Shipping</td>
              <td>৳{{shipping}}</td>
            </tr>
            {{#if tax}}
              <tr>
                <td>Tax</td>
                <td>৳{{tax}}</td>
              </tr>
            {{/if}}
            <tr class='grand-total-row'>
              <td>Grand Total</td>
              <td>৳{{grandTotal}}</td>
            </tr>
          </table>
        </div>
      </div>

      <div class='receipt-footer'>
        {{#if qrCodeDataUrl}}
          <div class='qr-code'>
            <img src='{{qrCodeDataUrl}}' alt='QR Code' />
          </div>
        {{/if}}
        <p class='thank-you'>Thank you for shopping with
          <span>Core Learning Centre</span>!</p>
        <p class='meta-line'>
          For any queries, please contact our support team.<br />
          Receipt generated on
          {{date}}
        </p>
        <div class='footer-brand-strip'>
          <span class='on'></span><span class='on'></span><span
            class='on'
          ></span>
        </div>
      </div>
    </div>
  </body>
</html>