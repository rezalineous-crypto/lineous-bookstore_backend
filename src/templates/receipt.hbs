<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Receipt - {{receiptNumber}}</title>
    <link
      href='https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600&family=Noto+Sans:wght@400;500;600;700&display=swap'
      rel='stylesheet'
    />
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      :root {
        --navy: #16305a;
        --navy-deep: #0e2142;
        --teal: #16a6b6;
        --teal-dark: #0e8493;
        --orange: #f5a623;
        --orange-dark: #e8890b;
        --ink: #1e293b;
        --muted: #64748b;
        --line: #e2e8f0;
        --soft: #f7fafc;
        --bg: #eef3f7;
      }

      body {
        background: var(--bg);
        color: var(--ink);
        font-family: Inter, 'Noto Sans', sans-serif;
        {% comment %} padding: 36px 20px; {% endcomment %}
        -webkit-font-smoothing: antialiased;
      }

      .receipt-container {
        width: 100%;
        max-width: 800px;
        margin: 0 auto;
        background: #fff;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 18px 48px rgba(14, 33, 66, 0.14);
        position: relative;
      }

      .receipt-header {
        min-height: 124px;
        display: flex;
        align-items: center;
        gap: 17px;
        padding: 30px 38px;
        color: #fff;
        background: linear-gradient(
          130deg,
          var(--navy-deep) 0%,
          var(--navy) 58%,
          var(--teal-dark) 100%
        );
      }

      .brand-mark {
        width: 54px;
        height: 54px;
        flex: 0 0 54px;
        border-radius: 11px;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #05121f;
        box-shadow: 0 5px 14px rgba(0, 0, 0, 0.2);
      }

      .brand-mark img {
        width: 100%;
        height: 100%;
        object-fit: contain;
      }

      .brand-mark.fallback span {
        width: 50%;
        height: 100%;
        display: flex;
        align-items: flex-end;
        justify-content: center;
        padding-bottom: 7px;
        color: #fff;
        font:
          700 9px 'JetBrains Mono',
          monospace;
      }
      .brand-mark.fallback span:first-child {
        background: var(--teal);
      }
      .brand-mark.fallback span:last-child {
        background: var(--orange);
      }

      .brand-copy {
        min-width: 0;
      }
      .brand-copy h1 {
        font-size: 21px;
        line-height: 1.25;
        font-weight: 800;
        letter-spacing: -0.45px;
      }
      .brand-copy p {
        margin-top: 5px;
        color: rgba(255, 255, 255, 0.72);
        font-size: 12px;
        letter-spacing: 0.15px;
      }

      .receipt-tag {
        margin-left: auto;
        padding-left: 18px;
        text-align: right;
        flex: 0 0 auto;
      }
      .receipt-tag .label {
        color: rgba(255, 255, 255, 0.62);
        font:
          600 10px 'JetBrains Mono',
          monospace;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }
      .receipt-tag .value {
        margin-top: 6px;
        font-size: 16px;
        line-height: 1.3;
        font-weight: 700;
        overflow-wrap: anywhere;
      }

      .brand-strip {
        display: flex;
        height: 5px;
      }
      .brand-strip span {
        flex: 1;
      }
      .brand-strip span:first-child {
        background: var(--teal);
      }
      .brand-strip span:last-child {
        background: linear-gradient(90deg, var(--orange), var(--orange-dark));
      }

      .receipt-body {
        padding: 32px 38px 30px;
      }

      .section-heading {
        margin-bottom: 14px;
        color: var(--navy);
        font-size: 12px;
        line-height: 1.3;
        font-weight: 800;
        letter-spacing: 0.075em;
        text-transform: uppercase;
      }

      .receipt-meta {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 18px;
        padding: 0 0 25px;
        margin-bottom: 26px;
        border-bottom: 1px dashed #cbd5e1;
      }

      .meta-item {
        min-width: 0;
      }
      .meta-label {
        display: block;
        margin-bottom: 7px;
        color: var(--muted);
        font:
          600 9px 'JetBrains Mono',
          monospace;
        letter-spacing: 0.095em;
        text-transform: uppercase;
      }
      .meta-value {
        display: block;
        color: var(--ink);
        font-size: 13px;
        line-height: 1.5;
        font-weight: 650;
        overflow-wrap: anywhere;
      }
      .meta-value.highlight {
        color: var(--teal-dark);
        font-weight: 750;
      }

      .status-pill {
        display: inline-flex;
        align-items: center;
        min-height: 23px;
        padding: 3px 9px;
        border-radius: 999px;
        background: rgba(22, 166, 182, 0.12);
        color: var(--teal-dark);
        font-size: 10px;
        line-height: 1.2;
        font-weight: 750;
        letter-spacing: 0.025em;
        text-transform: uppercase;
      }

      .customer-section {
        margin-bottom: 28px;
        padding: 19px 20px 18px;
        border: 1px solid var(--line);
        border-radius: 10px;
        background: #fbfcfe;
        break-inside: avoid;
      }

      .customer-section .section-heading {
        margin-bottom: 13px;
      }

      .customer-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        column-gap: 26px;
        row-gap: 12px;
      }

      .customer-field {
        min-width: 0;
      }
      .customer-field.full {
        grid-column: 1 / -1;
      }
      .customer-label {
        display: block;
        margin-bottom: 3px;
        color: var(--muted);
        font-size: 10px;
        line-height: 1.35;
        font-weight: 600;
      }
      .customer-value {
        display: block;
        color: var(--ink);
        font-size: 12px;
        line-height: 1.55;
        font-weight: 550;
        overflow-wrap: anywhere;
      }
      .address-lines {
        display: grid;
        gap: 2px;
      }

      .items-section {
        margin-top: 2px;
      }
      .items-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        margin-bottom: 22px;
        table-layout: fixed;
      }
      .items-table thead th {
        padding: 12px 13px;
        background: var(--navy);
        color: #fff;
        text-align: left;
        font:
          600 9px 'JetBrains Mono',
          monospace;
        letter-spacing: 0.09em;
        text-transform: uppercase;
        white-space: nowrap;
      }
      .items-table thead th:first-child {
        border-radius: 7px 0 0 7px;
      }
      .items-table thead th:last-child {
        border-radius: 0 7px 7px 0;
      }
      .items-table th.qty,
      .items-table td.qty {
        text-align: center;
      }
      .items-table th.money,
      .items-table td.money {
        text-align: right;
      }

      .items-table tbody td {
        padding: 14px 13px;
        border-bottom: 1px solid var(--line);
        color: var(--ink);
        font-size: 12px;
        line-height: 1.5;
        vertical-align: top;
        overflow-wrap: anywhere;
      }
      .items-table tbody tr:last-child td {
        border-bottom: 1px solid var(--line);
      }
      .item-name {
        font-weight: 650;
        color: var(--ink);
      }
      .item-variant {
        margin-top: 3px;
        color: var(--muted);
        font-size: 10px;
        line-height: 1.4;
      }
      .items-table td.qty {
        color: var(--muted);
        font-weight: 600;
      }
      .items-table td.money {
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
      }

      .totals-section {
        display: flex;
        justify-content: flex-end;
        margin-top: 2px;
        margin-bottom: 3px;
      }
      .totals-table {
        width: min(100%, 330px);
        border-collapse: collapse;
      }
      .totals-table td {
        padding: 7px 0;
        color: var(--muted);
        font-size: 12px;
        line-height: 1.4;
      }
      .totals-table td:last-child {
        padding-left: 20px;
        color: var(--ink);
        text-align: right;
        font-weight: 650;
        white-space: nowrap;
        font-variant-numeric: tabular-nums;
      }
      .totals-table .discount-row td:last-child {
        color: var(--orange-dark);
      }
      .totals-table .grand-total-row td {
        padding-top: 15px;
        border-top: 2px solid var(--navy);
      }
      .totals-table .grand-total-row td:first-child {
        color: var(--ink);
        font-size: 13px;
        font-weight: 800;
      }
      .totals-table .grand-total-row td:last-child {
        color: var(--teal-dark);
        font-size: 20px;
        font-weight: 800;
        letter-spacing: -0.35px;
      }

      .receipt-footer {
        padding: 26px 38px 28px;
        border-top: 1px solid var(--line);
        background: linear-gradient(180deg, #f8fafc 0%, #eef3f7 100%);
        text-align: center;
      }
      .qr-code {
        display: inline-block;
        margin-bottom: 17px;
        padding: 9px;
        border: 1px solid var(--line);
        border-radius: 9px;
        background: #fff;
        box-shadow: 0 3px 10px rgba(14, 33, 66, 0.07);
      }
      .qr-code img {
        display: block;
        width: 104px;
        height: 104px;
      }
      .thank-you {
        margin-bottom: 7px;
        color: var(--ink);
        font-size: 14px;
        line-height: 1.5;
        font-weight: 750;
      }
      .thank-you span {
        color: var(--teal-dark);
      }
      .meta-line {
        color: var(--muted);
        font-size: 10px;
        line-height: 1.75;
      }
      .footer-brand-strip {
        display: flex;
        justify-content: center;
        gap: 5px;
        margin-top: 17px;
      }
      .footer-brand-strip span {
        width: 20px;
        height: 4px;
        border-radius: 2px;
        background: var(--line);
      }
      .footer-brand-strip span.on:nth-child(1) {
        background: var(--teal);
      }
      .footer-brand-strip span.on:nth-child(2) {
        background: var(--navy);
      }
      .footer-brand-strip span.on:nth-child(3) {
        background: var(--orange);
      }

      .watermark {
        position: fixed;
        top: 50%;
        left: 50%;
        z-index: 0;
        transform: translate(-50%, -50%) rotate(-30deg);
        color: rgba(22, 48, 90, 0.035);
        font-size: 116px;
        font-weight: 800;
        letter-spacing: 0.05em;
        white-space: nowrap;
        pointer-events: none;
      }

      @media (max-width: 640px) {
        body {
          padding: 12px;
        }
        .receipt-container {
          border-radius: 12px;
        }
        .receipt-header {
          padding: 24px 22px;
          gap: 12px;
          flex-wrap: wrap;
        }
        .brand-mark {
          width: 46px;
          height: 46px;
          flex-basis: 46px;
        }
        .brand-copy h1 {
          font-size: 18px;
        }
        .brand-copy p {
          font-size: 11px;
        }
        .receipt-tag {
          width: 100%;
          margin: 5px 0 0 58px;
          padding: 0;
          text-align: left;
        }
        .receipt-tag .value {
          font-size: 14px;
        }
        .receipt-body {
          padding: 25px 22px 24px;
        }
        .receipt-meta {
          grid-template-columns: repeat(2, minmax(0, 1fr));
          gap: 18px 14px;
        }
        .customer-section {
          padding: 16px;
        }
        .customer-grid {
          column-gap: 14px;
        }
        .items-table {
          table-layout: auto;
        }
        .items-table thead th,
        .items-table tbody td {
          padding: 10px 7px;
        }
        .items-table thead th {
          font-size: 8px;
          letter-spacing: 0.04em;
        }
        .items-table tbody td {
          font-size: 10px;
        }
        .item-variant {
          font-size: 9px;
        }
        .totals-table {
          width: 100%;
          max-width: 330px;
        }
        .receipt-footer {
          padding: 24px 22px;
        }
        .watermark {
          font-size: 64px;
        }
      }

      @media (max-width: 380px) {
        .customer-grid {
          grid-template-columns: 1fr;
        }
        .customer-field.full {
          grid-column: auto;
        }
        .items-table thead th,
        .items-table tbody td {
          padding-left: 5px;
          padding-right: 5px;
        }
        .items-table tbody td {
          font-size: 9px;
        }
      }

      @page {
        size: A4;
        margin: 0;
      }
      @media print {
        html,
        body {
          padding: 0 !important;
          margin: 0 !important;
          background: #fff !important;
        }
        body {
          -webkit-print-color-adjust: exact;
          print-color-adjust: exact;
        }
        .receipt-container {
          max-width: none;
          width: 100%;
          border-radius: 0;
          box-shadow: none;
          overflow: visible;
        }
        .watermark {
          display: none;
        }
        .receipt-header,
        .items-table thead th,
        .brand-strip,
        .receipt-footer {
          -webkit-print-color-adjust: exact;
          print-color-adjust: exact;
        }
        .receipt-meta,
        .customer-section,
        .items-table tr,
        .totals-section,
        .receipt-footer {
          break-inside: avoid;
        }
        .items-table {
          break-inside: auto;
        }
        .items-table thead {
          display: table-header-group;
        }
        .items-table tfoot {
          display: table-footer-group;
        }
      }
    </style>
  </head>
  <body>
    <div class='watermark'>{{#if
        paymentStatus
      }}{{paymentStatus}}{{else}}PAID{{/if}}</div>

    <div class='receipt-container'>
      <header class='receipt-header'>
        {{#if logoUrl}}
          <div class='brand-mark'>
            <img src='{{logoUrl}}' alt='Core Learning Centre' />
          </div>
        {{else}}
          <div class='brand-mark fallback'>
            <span>CORE</span><span>CLC</span>
          </div>
        {{/if}}

        <div class='brand-copy'>
          <h1>Core Learning Centre</h1>
          <p>LEARN WITH EXCELLENCE</p>
        </div>

        <div class='receipt-tag'>
          <div class='label'>Receipt</div>
          <div class='value'>#{{receiptNumber}}</div>
        </div>
      </header>

      <div class='brand-strip'><span></span><span></span></div>

      <main class='receipt-body'>
        <section class='receipt-meta'>
          <div class='meta-item'>
            <span class='meta-label'>Date</span>
            <span class='meta-value'>{{date}}</span>
          </div>
          <div class='meta-item'>
            <span class='meta-label'>Payment Method</span>
            <span class='meta-value'>{{paymentMethod}}</span>
          </div>
          <div class='meta-item'>
            <span class='meta-label'>Payment Status</span>
            <span class='meta-value'><span
                class='status-pill'
              >{{paymentStatus}}</span></span>
          </div>
        </section>

        <section class='customer-section'>
          <h2 class='section-heading'>Customer Details</h2>
          <div class='customer-grid'>
            <div class='customer-field'>
              <span class='customer-label'>Customer Name</span>
              <span class='customer-value'>{{customerName}}</span>
            </div>
            {{#if customerPhone}}
              <div class='customer-field'>
                <span class='customer-label'>Phone Number</span>
                <span class='customer-value'>{{customerPhone}}</span>
              </div>
            {{/if}}
            {{#if customerEmail}}
              <div class='customer-field'>
                <span class='customer-label'>Email Address</span>
                <span class='customer-value'>{{customerEmail}}</span>
              </div>
            {{/if}}
            {{#if address}}
              <div class='customer-field'>
                <span class='customer-label'>Delivery Contact</span>
                <span class='customer-value'>{{address.name}} - 
                  {{address.phone}}</span>
              </div>
              <div class='customer-field full'>
                <span class='customer-label'>Delivery Address</span>
                <div class='address-lines'>
                  {{#if address.addressLine}}<span
                      class='customer-value'
                    >{{address.addressLine}}</span>{{/if}}
                  {{#if address.area}}<span
                      class='customer-value'
                    >{{address.area}}</span>{{/if}}
                  <span class='customer-value'>{{address.district}}{{#if
                      address.division
                    }}, {{address.division}}{{/if}}{{#if address.postalCode}}
                      -
                      {{address.postalCode}}{{/if}}</span>
                  {{#if address.country}}<span
                      class='customer-value'
                    >{{address.country}}</span>{{/if}}
                </div>
              </div>
            {{/if}}
          </div>
        </section>

        <section class='items-section'>
          <h2 class='section-heading'>Order Summary</h2>
          <table class='items-table'>
            <thead>
              <tr>
                <th style='width: 42%;'>Item</th>
                <th class='qty' style='width: 12%;'>Qty</th>
                <th class='money' style='width: 21%;'>Price</th>
                <th class='money' style='width: 25%;'>Subtotal</th>
              </tr>
            </thead>
            <tbody>
              {{#each items}}
                <tr>
                  <td>
                    <div class='item-name'>{{bookTitle}}</div>
                    {{#if paperName}}
                      <div class='item-variant'>{{paperName}}</div>
                    {{/if}}
                  </td>
                  <td class='qty'>{{quantity}}</td>
                  <td class='money'>TK {{unitPrice}}</td>
                  <td class='money'>TK {{subtotal}}</td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        </section>

        <section class='totals-section'>
          <table class='totals-table'>
            <tr>
              <td>Subtotal</td>
              <td>TK {{subtotal}}</td>
            </tr>
            {{#if discount}}
              <tr class='discount-row'>
                <td>Discount</td>
                <td>-TK {{discount}}</td>
              </tr>
            {{/if}}
            <tr>
              <td>Shipping</td>
              <td>TK {{shipping}}</td>
            </tr>
            {{#if tax}}
              <tr>
                <td>Tax</td>
                <td>TK {{tax}}</td>
              </tr>
            {{/if}}
            <tr class='grand-total-row'>
              <td>Grand Total</td>
              <td>TK {{grandTotal}}</td>
            </tr>
          </table>
        </section>
      </main>

      <footer class='receipt-footer'>
        {{#if qrCodeDataUrl}}
          <div class='qr-code'>
            <img src='{{qrCodeDataUrl}}' alt='Receipt QR Code' />
          </div>
        {{/if}}
        <p class='thank-you'>Thank you for shopping with
          <span>Core Learning Centre</span>!</p>
        <p class='meta-line' style='font-weight: 700; margin-bottom: 8px;'>For any queries</p>
        <div style='display: flex; justify-content: center; gap: 20px; font-size: 12px; color: var(--muted);'>
          <span>+8801764415165</span>
          <span>+8801968524143</span>
        </div>
        <p class='meta-line' style='margin-top: 12px;'>Receipt generated on {{date}}</p>
        <div class='footer-brand-strip'>
          <span class='on'></span><span class='on'></span><span
            class='on'
          ></span>
        </div>
      </footer>
    </div>
  </body>
</html>